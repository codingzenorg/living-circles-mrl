{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codingzen.org/living-circles/contracts/movement-intent.schema.json",
  "title": "MovementIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "direction"],
  "properties": {
    "type": {
      "const": "movement_intent"
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
