{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codingzen.org/living-circles/contracts/world-snapshot.schema.json",
  "title": "WorldSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "tick", "world", "player", "autonomous_circles", "interaction", "foods"],
  "properties": {
    "type": {
      "const": "world_snapshot"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "player": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "lineage_id", "generation", "shape", "x", "y", "radius", "energy", "attached_children"],
          "properties": {
            "id": {
              "type": "string"
            },
            "lineage_id": {
              "type": "string"
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "shape": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "energy": {
              "type": "number",
              "minimum": 0
            },
            "attached_children": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "owner_id", "orbit_slot", "x", "y", "radius"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "owner_id": {
                    "type": "string"
                  },
                  "orbit_slot": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "autonomous_circles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lineage_id", "generation", "shape", "x", "y", "radius", "energy", "attached_children"],
        "properties": {
          "id": {
            "type": "string"
          },
          "lineage_id": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "shape": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "energy": {
            "type": "number",
            "minimum": 0
          },
          "attached_children": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "owner_id", "orbit_slot", "x", "y", "radius"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "owner_id": {
                  "type": "string"
                },
                "orbit_slot": {
                  "type": "integer",
                  "minimum": 0
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "interaction": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["active", "resolved", "kind", "source_id", "target_id"],
          "properties": {
            "active": {
              "type": "boolean"
            },
            "resolved": {
              "type": "boolean"
            },
            "kind": {
              "enum": ["reproduce_resolved", "reproduce_paid_child", "reproduce_blocked_energy", "fight_resolved", "fight_absorbed_child", "death_promoted_child"]
            },
            "contact_origin": {
              "enum": ["parent_body", "attached_child"]
            },
            "contact_path_kind": {
              "enum": ["source_child_to_target_parent", "source_parent_to_target_child", "child_to_child"]
            },
            "distribution_kind": {
              "enum": ["source_only", "split", "target_only"]
            },
            "source_id": {
              "type": "string"
            },
            "target_id": {
              "type": "string"
            },
            "source_child_id": {
              "type": "string"
            },
            "target_child_id": {
              "type": "string"
            },
            "winner_id": {
              "type": "string"
            },
            "loser_id": {
              "type": "string"
            },
            "promoted_child_id": {
              "type": "string"
            },
            "absorbed_child_id": {
              "type": "string"
            },
            "source_paid_child": {
              "type": "boolean"
            },
            "target_paid_child": {
              "type": "boolean"
            },
            "source_paid_child_id": {
              "type": "string"
            },
            "target_paid_child_id": {
              "type": "string"
            },
            "created_child_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_created_child_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_created_child_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_blocked_capacity": {
              "type": "boolean"
            },
            "target_blocked_capacity": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "foods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "radius"],
        "properties": {
          "id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
